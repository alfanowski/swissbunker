# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Node / web
node_modules/
dist/
.vite/
*.tsbuildinfo

# Build artifacts and model weights — never committed, they live on the disk
/models/
/content/
/index/
*.zim
*.pmtiles
*.onnx
*.gguf
*.wasm.map

# Derived vendor bundles: regenerated by spikes/phase-0/tools/build-vendor.sh, and that
# script needs npm install anyway — so committing 850 KB of base64 buys nothing.
spikes/*/vendor/

# Built bundles and generated sources: reproduced by web/build.mjs
web/dist/
web/src/generated/

# Test fixtures: rebuilt by web/tools/make-tiny-fixture.py
web/test/fixtures/*.sqlite

# Local state
.state/
*.sqlite
*.sqlite-*
.DS_Store
.env
.env.local

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
